include("${CMAKE_CURRENT_LIST_DIR}/WL2Dependency.cmake")

function(_wl2_nlohmann_json_include_root root out_var)
    if(EXISTS "${root}/include/nlohmann/json.hpp")
        set(${out_var} "${root}/include" PARENT_SCOPE)
    elseif(EXISTS "${root}/nlohmann/json.hpp")
        set(${out_var} "${root}" PARENT_SCOPE)
    else()
        set(${out_var} "" PARENT_SCOPE)
    endif()
endfunction()

function(wl2_find_nlohmann_json)
    if(TARGET nlohmann_json::nlohmann_json)
        set(WL2_HAVE_NLOHMANN_JSON TRUE PARENT_SCOPE)
        set(WL2_NLOHMANN_JSON_TARGET nlohmann_json::nlohmann_json PARENT_SCOPE)
        return()
    endif()

    wl2_dependency_normalize_provider(NLOHMANN_JSON WL2_NLOHMANN_JSON_PROVIDER)

    if(WL2_NLOHMANN_JSON_PROVIDER STREQUAL "off")
        message(FATAL_ERROR "nlohmann_json is required; WL2_NLOHMANN_JSON_PROVIDER=off is not supported")
    endif()

    set(_roots)
    if(WL2_NLOHMANN_JSON_ROOT)
        list(APPEND _roots "${WL2_NLOHMANN_JSON_ROOT}")
    endif()
    if(WL2_DEPS_ROOT)
        list(APPEND _roots "${WL2_DEPS_ROOT}/nlohmann_json")
    endif()

    if(NOT WL2_NLOHMANN_JSON_PROVIDER STREQUAL "package"
            AND NOT WL2_NLOHMANN_JSON_PROVIDER STREQUAL "fetch")
        foreach(_root IN LISTS _roots)
            _wl2_nlohmann_json_include_root("${_root}" _include_root)
            if(_include_root)
                add_library(wl2_nlohmann_json_dependency INTERFACE)
                add_library(nlohmann_json::nlohmann_json ALIAS wl2_nlohmann_json_dependency)
                target_include_directories(wl2_nlohmann_json_dependency
                    INTERFACE
                        $<BUILD_INTERFACE:${_include_root}>
                        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
                message(STATUS "Using local nlohmann_json from ${_include_root}")
                wl2_dependency_note_result(nlohmann_json local "${_include_root}")
                set(WL2_HAVE_NLOHMANN_JSON TRUE PARENT_SCOPE)
                set(WL2_NLOHMANN_JSON_TARGET nlohmann_json::nlohmann_json PARENT_SCOPE)
                set(WL2_NLOHMANN_JSON_INCLUDE_DIR "${_include_root}" PARENT_SCOPE)
                return()
            endif()
        endforeach()
        if(WL2_NLOHMANN_JSON_PROVIDER STREQUAL "local")
            message(FATAL_ERROR "WL2_NLOHMANN_JSON_PROVIDER=local but nlohmann/json.hpp was not found")
        endif()
    endif()

    if(WL2_NLOHMANN_JSON_PROVIDER STREQUAL "package" OR WL2_NLOHMANN_JSON_PROVIDER STREQUAL "auto")
        wl2_dependency_note_package(NLOHMANN_JSON "${WL2_NLOHMANN_JSON_PROVIDER}")
        find_package(nlohmann_json ${WL2_NLOHMANN_JSON_VERSION} CONFIG QUIET)
        if(TARGET nlohmann_json::nlohmann_json)
            get_target_property(_include_root nlohmann_json::nlohmann_json INTERFACE_INCLUDE_DIRECTORIES)
            message(STATUS "Using package/system nlohmann_json target nlohmann_json::nlohmann_json")
            wl2_dependency_note_result(nlohmann_json system "nlohmann_json::nlohmann_json")
            set(WL2_HAVE_NLOHMANN_JSON TRUE PARENT_SCOPE)
            set(WL2_NLOHMANN_JSON_TARGET nlohmann_json::nlohmann_json PARENT_SCOPE)
            set(WL2_NLOHMANN_JSON_INCLUDE_DIR "${_include_root}" PARENT_SCOPE)
            return()
        endif()
        if(WL2_NLOHMANN_JSON_PROVIDER STREQUAL "package")
            message(FATAL_ERROR "WL2_NLOHMANN_JSON_PROVIDER=package but nlohmann_json ${WL2_NLOHMANN_JSON_VERSION} was not found")
        endif()
    endif()

    if(WL2_NLOHMANN_JSON_PROVIDER STREQUAL "fetch" OR WL2_NLOHMANN_JSON_PROVIDER STREQUAL "auto")
        include(FetchContent)
        set(FETCHCONTENT_BASE_DIR "${WL2_DEPS_ROOT}/_fetch" CACHE PATH "FetchContent base directory" FORCE)

        message(STATUS "Fetching nlohmann_json ${WL2_NLOHMANN_JSON_VERSION} from ${WL2_NLOHMANN_JSON_URL}")
        FetchContent_Declare(
            nlohmann_json_source
            URL "${WL2_NLOHMANN_JSON_URL}"
            DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
        FetchContent_MakeAvailable(nlohmann_json_source)

        if(NOT TARGET nlohmann_json::nlohmann_json)
            message(FATAL_ERROR "Fetched nlohmann_json did not provide target nlohmann_json::nlohmann_json")
        endif()
        get_target_property(_include_root nlohmann_json::nlohmann_json INTERFACE_INCLUDE_DIRECTORIES)
        message(STATUS "Using fetched nlohmann_json ${WL2_NLOHMANN_JSON_VERSION}")
        wl2_dependency_note_result(nlohmann_json download "${WL2_NLOHMANN_JSON_VERSION}")
        set(WL2_HAVE_NLOHMANN_JSON TRUE PARENT_SCOPE)
        set(WL2_NLOHMANN_JSON_TARGET nlohmann_json::nlohmann_json PARENT_SCOPE)
        set(WL2_NLOHMANN_JSON_INCLUDE_DIR "${_include_root}" PARENT_SCOPE)
        return()
    endif()

    message(FATAL_ERROR "nlohmann_json is required but was not found")
endfunction()
